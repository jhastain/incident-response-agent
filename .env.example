# Local development configuration for the Incident Response Agent.
# For deployment, these are set via Terraform / the deploy command / Secret Manager.

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=aiops-dev-project
GOOGLE_CLOUD_LOCATION=global

# Bifrost MCP gateway (unified tool gateway). The virtual key governs which
# MCP servers/tools this agent can reach (datadog_token, sentry_token,
# azure_devops_token). Injected at deploy time as a Secret Manager secret.
#
# BIFROST_MCP_URL / BIFROST_LLM_URL are REQUIRED — app/config.py raises if either
# is unset (ADO-200022). They previously defaulted to the PROD gateway, so a local
# run with them missing routed every LLM and MCP call through prod. Each
# environment has its own gateway; pick the one matching GOOGLE_CLOUD_PROJECT:
#   aiops-test-project -> https://llm-gateway-test.internal.example
#   aiops-prod-project -> https://llm-gateway.internal.example
# Left blank on purpose: choose deliberately rather than inheriting prod.
BIFROST_API_TOKEN=your-bifrost-virtual-key
BIFROST_MCP_URL=
BIFROST_LLM_URL=

# Persistence (findings written to GCS + Firestore for historical context)
LOGS_BUCKET_NAME=incident-summaries

# Direct-REST tool credentials (not routed through Bifrost):
# ADO pipeline analysis (base64 of ":<PAT>") and Octopus deploy task watcher.
IR_AGENT_ADO_READONLY=
IR_AGENT_OCTOPUS_TASK_WATCHER=

# Datadog Agent Observability (ddtrace LLM Obs). Disabled unless DD_LLMOBS_ENABLED
# is true. DD_API_KEY is injected at deploy time from Secret Manager
# (ir-agent-dd-api-key). ml_app MUST stay explicit — it propagates, and Bifrost
# upstream sets ml_app=bifrost-gateway.
DD_LLMOBS_ENABLED=false
DD_API_KEY=
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ML_APP=ir-agent
DD_SERVICE=ir-agent
DD_ENV=dev
# Fraction of runs traced. Trace 100% — tracing is cheap and these are the
# agent's own verification scores, which cost nothing extra to emit. The
# judges sample separately at 25% in the Datadog UI, giving roughly 2-3 judged
# runs/day at ~10 runs/day, so correctness monitors need a multi-day window.
DD_LLMOBS_SAMPLE_RATE=1.0
