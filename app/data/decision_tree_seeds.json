  {
    "category": "content-archive",
    "version": 1,
    "system_model": "ContentArchive-Configure (def 501, trigger:none) is the LAST link in a chain; it never self-schedules. Request(2452, cron 1:30AM CT) creates WebCore PR 'Archive Site - <yesterday>' -> WebCore branch policy -> Ephemeral-Build(2584) -> Obtain-Env(2361)+SolutionBuild(queues Solution-Tests 2415, FRAGILE)+CallDeployStage(condition succeeded()) -> Ephemeral-Deploy(2362) -> CallConfigureContentArchiveStage(if IS_ARCHIVE_SITE=='true') -> queues Configure(2451). Monitor DD 16605223 (US5) default_zero(query2).current('1d')<1, eval 10AM CT.",
    "source_of_truth_order": "ADO builds API > repo file/branch state > Datadog CI Visibility > memory. ADO wins over Datadog on disagreement.",
    "triage_steps": [
      {
        "order": 0,
        "agent": "historical_context_agent",
