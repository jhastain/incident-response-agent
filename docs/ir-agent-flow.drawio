        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="Incident Response Agent -- End-to-End Flow and Decision Points" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="880" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Verified against app/agent.py, app/tier1_routing.py, app/sub_agents/**, app/tools/**, app/app_utils/**, integrations/pagerduty/ -- 2026-08-31&#10;Deployed to test: ae9934d, reasoningEngines/1000000000000000001 (project 000000000001). Diamonds = decisions. Dashed red = NOT working today." style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="360" y="54" width="880" height="34" as="geometry" />
