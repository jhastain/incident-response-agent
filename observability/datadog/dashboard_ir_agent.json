        "type": "query_value",
        "title": "RUNS",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "formulas": [
              {
                "formula": "runs"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "runs",
                "query": "sum:ml_obs.trace{$env,$ml_app}.as_count()",
                "aggregator": "sum"
              }
            ]
          }
        ],
        "precision": 0
